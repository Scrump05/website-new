# Dependencies (this is the folder that causes the 1800+ files)
node_modules/

# Environment variables and secrets (important once you add a backend)
.env
.env.*
!.env.example

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build / cache output
.cache/
.parcel-cache/
.vite/
.next/
coverage/
# dist/ and build/ are ignored by default. If you deploy with GitHub Pages
# and commit your compiled Tailwind CSS, remove the matching line below.
dist/
build/

# Future backend / local data
*.sqlite
*.sqlite3
*.db
uploads/

# Python backend (if you go that route)
__pycache__/
*.pyc
.venv/
venv/

# Logs
*.log
logs/

# Editor and OS files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
